---
// 모든 페이지의 공통 틀 — <head>(SEO·조회수 수집 포함), 머리말(카테고리 메뉴), 꼬리말, 다크 모드 전환을 담당한다.
import "../styles/global.css";
import Seo, { type SeoProps } from "../components/Seo.astro";
import { SITE, CATEGORIES } from "../site";

interface Props {
  title?: string;
  description?: string;
  // 메뉴에서 강조할 카테고리 slug
  activeCategory?: string;
  // 본문 폭: 기본은 목록용, wide 는 글+목차용
  width?: "default" | "wide";
  // 글 페이지에서 넘기는 SEO 정보(article 타입, 작성일, 태그 등)
  seo?: Partial<SeoProps>;
}

const { title, description = SITE.description, activeCategory, width = "default", seo = {} } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <Seo title={pageTitle} description={description} {...seo} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${base}rss.xml`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    {SITE.goatcounter && (
      <script is:inline async data-goatcounter={`https://${SITE.goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
    )}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap" />
    <script is:inline>
      // 저장해 둔 테마를 화면이 그려지기 전에 적용해서 깜빡임을 막는다
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="top">
          <a class="brand" href={base} aria-label={SITE.title}>
            <span class="brand-mark">y</span>
            <span class="brand-name">youngapi<span>.log</span></span>
          </a>
          <nav class="top-links" aria-label="주요 메뉴">
            <a href={`${base}posts/`} aria-current={path.startsWith(`${base}posts`) ? "page" : undefined}>글</a>
            <a href={`${base}tags/`} aria-current={path.startsWith(`${base}tags`) ? "page" : undefined}>태그</a>
            <a href={`${base}about/`} aria-current={path.startsWith(`${base}about`) ? "page" : undefined}>소개</a>
            <a href={`${base}admin/`} id="admin-link" class="admin-link" hidden aria-current={path.startsWith(`${base}admin`) ? "page" : undefined}>관리</a>
            <button class="icon-btn" type="button" aria-label="다크 모드 전환" id="theme-toggle">
              <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            </button>
          </nav>
        </div>
        <nav class="cat-nav" aria-label="기술 카테고리">
          {CATEGORIES.map((c) => (
            <div class="cat-item" style={`--cat:${c.color}`}>
              <a href={`${base}category/${c.slug}/`} aria-current={activeCategory === c.slug ? "page" : undefined}>
                <i class="dot"></i>{c.name}
              </a>
              {c.children.length > 0 && (
                <div class="cat-menu">
                  {c.children.map((s) => (
                    <a href={`${base}category/${c.slug}/${s.slug}/`}>{s.name}</a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </nav>
      </div>
    </header>
    <main class:list={["container", width === "wide" ? "is-wide" : "is-default"]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>{SITE.title}</strong>
          <p>{SITE.description}</p>
        </div>
        <div class="footer-links">
          <a href={SITE.github}>GitHub</a>
          <a href={`${base}rss.xml`}>RSS</a>
          <a href={`${base}admin/`}>관리</a>
          <span>© {new Date().getFullYear()} {SITE.author}</span>
        </div>
      </div>
    </footer>
    {SITE.goatcounter && (
      <script is:inline define:vars={{ code: SITE.goatcounter }}>
        // data-views="경로" 칸마다 GoatCounter 공개 카운터에서 조회수를 받아 채운다. 실패하면 "-" 그대로 둔다
        document.querySelectorAll("[data-views]").forEach(async (el) => {
          try {
            const res = await fetch(`https://${code}.goatcounter.com/counter/${encodeURIComponent(el.dataset.views)}.json`);
            if (res.ok) el.textContent = (await res.json()).count;
            else if (res.status === 404) el.textContent = "0";
          } catch {}
        });
      </script>
    )}
    <script is:inline>
      // 관리 페이지에 로그인한 브라우저(토큰이 저장돼 있음)에서만 머리말에 "관리" 버튼을 보인다
      try {
        if (localStorage.getItem("devlog-admin-token")) document.getElementById("admin-link").hidden = false;
      } catch {}
    </script>
    <script is:inline>
      // 버튼을 누르면 라이트/다크를 바꾸고 선택을 기억한다
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
      });
    </script>
  </body>
</html>
