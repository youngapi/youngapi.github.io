---
// 첫 화면 — 소개, 최신 글(크게 하나 + 목록), 연·월별 기록 표, 프로젝트(있을 때), 카테고리(하위 포함), 많이 쓴 태그를 보여 준다.
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { countByMonth, countTags, getPublishedPosts, readingMinutes, subOf } from "../lib/posts";
import { CATEGORIES, PROJECTS, SITE, findCategory, formatDate } from "../site";

const posts = await getPublishedPosts();
const base = import.meta.env.BASE_URL;
const [latest, ...rest] = posts;
const recent = rest.slice(0, 6);
const tags = countTags(posts).slice(0, 24);
const months = countByMonth(posts);
const maxMonth = Math.max(1, ...[...months.values()].flat());
const categoryCount = (slug: string) => posts.filter((p) => p.data.category === slug).length;
const subCount = (slug: string, sub: string) =>
  posts.filter((p) => p.data.category === slug && subOf(p)?.slug === sub).length;

// 글 하나의 카테고리 이름(하위 포함)과 색을 돌려준다.
function labelOf(post: (typeof posts)[number]) {
  const c = findCategory(post.data.category);
  const s = subOf(post);
  return { name: s ? `${c.name} · ${s.name}` : c.name, color: c.color };
}

// 월별 칸의 진하기 단계(0~4).
const level = (n: number) => (n === 0 ? 0 : Math.min(4, Math.ceil((n / maxMonth) * 4)));
---

<BaseLayout>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Dev log</p>
      <h1>{SITE.description}</h1>
      <p class="hero-sub">그날 한 작업에서 쓴 기술, 어떻게 썼는지, 어디서 막혔는지를 적는다.</p>
      <div class="hero-links">
        <a class="btn" href={`${base}posts/`}>전체 글 보기</a>
        <a class="btn ghost" href={`${base}tags/`}>태그</a>
        <a class="btn ghost" href={SITE.github}>GitHub</a>
      </div>
    </div>
    <dl class="stats">
      <div><dt>글</dt><dd>{posts.length}</dd></div>
      <div><dt>태그</dt><dd>{countTags(posts).length}</dd></div>
      <div><dt>기록한 해</dt><dd>{months.size}</dd></div>
      <div><dt>마지막 글</dt><dd class="small">{latest ? formatDate(latest.data.date) : "-"}</dd></div>
    </dl>
  </section>

  {latest && (
    <section>
      <div class="section-row">
        <h2 class="section-title">최신 글</h2>
        <a class="more" href={`${base}posts/`}>전체 글 {posts.length}개 보기 →</a>
      </div>
      <div class="latest-grid">
        <a class="feature-card" href={`${base}posts/${latest.id}/`} style={`--cat:${labelOf(latest).color}`}>
          <span class="badge"><i class="dot"></i>{labelOf(latest).name}</span>
          <h3>{latest.data.title}</h3>
          <p>{latest.data.description}</p>
          <div class="meta">
            <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
            <span>· {readingMinutes(latest)}분</span>
            {latest.data.tags.slice(0, 4).map((t) => <span class="tag">#{t}</span>)}
          </div>
        </a>
        <ul class="recent-list">
          {recent.map((post) => (
            <li style={`--cat:${labelOf(post).color}`}>
              <a href={`${base}posts/${post.id}/`}>
                <span class="recent-meta"><i class="dot"></i>{labelOf(post).name} · {formatDate(post.data.date)}</span>
                <b>{post.data.title}</b>
              </a>
            </li>
          ))}
          {recent.length === 0 && <li class="empty">아직 글이 더 없다.</li>}
        </ul>
      </div>
    </section>
  )}

  <section>
    <div class="section-row">
      <h2 class="section-title">기록</h2>
      <span class="legend">적음 <i class="lv1"></i><i class="lv2"></i><i class="lv3"></i><i class="lv4"></i> 많음</span>
    </div>
    <div class="heat">
      <div class="heat-row heat-head">
        <span></span>
        {Array.from({ length: 12 }, (_, i) => <span>{i + 1}</span>)}
        <span></span>
      </div>
      {[...months.entries()].map(([year, counts]) => (
        <div class="heat-row">
          <a class="heat-year" href={`${base}posts/#y${year}`}>{year}</a>
          {counts.map((n, i) => (
            <span class={`cell lv${level(n)}`} title={`${year}년 ${i + 1}월 · 글 ${n}개`}></span>
          ))}
          <span class="heat-sum">{counts.reduce((a, b) => a + b, 0)}</span>
        </div>
      ))}
    </div>
  </section>

  {PROJECTS.length > 0 && (
    <section>
      <div class="section-row">
        <h2 class="section-title">프로젝트</h2>
        <a class="more" href={`${base}projects/`}>프로젝트 전체 →</a>
      </div>
      <div class="project-grid">
        {PROJECTS.slice(0, 4).map((p) => (
          <ProjectCard project={p} count={posts.filter((x) => x.data.project === p.slug).length} />
        ))}
      </div>
    </section>
  )}

  <section>
    <h2 class="section-title">기술별</h2>
    <div class="cat-grid">
      {CATEGORIES.map((c) => (
        <div class="cat-card" style={`--cat:${c.color}`}>
          <a class="cat-card-head" href={`${base}category/${c.slug}/`}>
            <span class="cat-name"><i class="dot"></i>{c.name}</span>
            <span class="count">{categoryCount(c.slug)}</span>
          </a>
          <small>{c.description}</small>
          {c.children.length > 0 && (
            <div class="sub-chips">
              {c.children.map((s) => (
                <a href={`${base}category/${c.slug}/${s.slug}/`}>{s.name}<span>{subCount(c.slug, s.slug)}</span></a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  {tags.length > 0 && (
    <section>
      <div class="section-row">
        <h2 class="section-title">많이 쓴 태그</h2>
        <a class="more" href={`${base}tags/`}>태그 전체 →</a>
      </div>
      <div class="tag-cloud">
        {tags.map(([tag, count]) => (
          <a href={`${base}tags/${tag}/`}>#{tag}<span>{count}</span></a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
