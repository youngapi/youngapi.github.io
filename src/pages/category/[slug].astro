---
// 카테고리별 글 목록 페이지 — 위에 하위 카테고리 칩을 두고, 이 카테고리의 글을 모두 보여 준다.
// 글이 없는 카테고리도 메뉴에서 열리도록 모두 만든다.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import SubNav from "../../components/SubNav.astro";
import { getPublishedPosts } from "../../lib/posts";
import { CATEGORIES, type Category } from "../../site";

// 카테고리마다 페이지를 하나씩 만든다.
export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props as { category: Category };
const posts = (await getPublishedPosts()).filter((p) => p.data.category === category.slug);
---

<BaseLayout title={category.name} description={category.description} activeCategory={category.slug}>
  <header class="page-head cat-head" style={`--cat:${category.color}`}>
    <p class="eyebrow"><i class="dot"></i>Category</p>
    <h1 class="page-title">{category.name}</h1>
    <p class="page-sub">{category.description} · 글 {posts.length}개</p>
  </header>
  <SubNav category={category} posts={posts} />
  <PostList posts={posts} hideCategory />
</BaseLayout>
