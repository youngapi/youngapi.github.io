---
// 글 상세 페이지 — 머리(카테고리·제목·날짜·읽는 시간·태그), 본문, 넓은 화면의 목차, 작업한 repo, 이전/다음 글.
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, readingMinutes, subOf, type Post } from "../../lib/posts";
import { findCategory, formatDate, SITE } from "../../site";

// 공개된 글마다 페이지를 하나씩 만들고, 앞뒤 글을 함께 넘긴다.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props as { post: Post; newer: Post | null; older: Post | null };
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const category = findCategory(post.data.category);
const sub = subOf(post);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  activeCategory={category.slug}
  width="wide"
  seo={{ type: "article", publishedTime: post.data.date, headline: post.data.title, section: sub ? `${category.name} > ${sub.name}` : category.name, tags: post.data.tags }}
>
  <div class="post-layout" style={`--cat:${category.color}`}>
    <article class="post">
      <header class="post-head">
        <div class="crumbs">
          <a class="badge" href={`${base}category/${category.slug}/`}><i class="dot"></i>{category.name}</a>
          {sub && <a class="badge sub" href={`${base}category/${category.slug}/${sub.slug}/`}>{sub.name}</a>}
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-desc">{post.data.description}</p>
        <div class="meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span>·</span>
          <span>{readingMinutes(post)}분</span>
          {SITE.goatcounter && (
            <>
              <span>·</span>
              <span>조회 <span data-views={`/posts/${post.id}/`}>-</span></span>
            </>
          )}
          {post.data.tags.map((tag) => <a class="tag" href={`${base}tags/${tag}/`}>#{tag}</a>)}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      {post.data.repos.length > 0 && (
        <aside class="repo-box">
          <span>작업한 저장소</span>
          <div>
            {post.data.repos.map((repo) => (
              <a href={`${SITE.github}/${repo}`}>{repo}</a>
            ))}
          </div>
        </aside>
      )}

      {(newer || older) && (
        <nav class="post-nav" aria-label="이전 글과 다음 글">
          {older ? (
            <a href={`${base}posts/${older.id}/`}><span>이전 글</span>{older.data.title}</a>
          ) : <span></span>}
          {newer && (
            <a class="next" href={`${base}posts/${newer.id}/`}><span>다음 글</span>{newer.data.title}</a>
          )}
        </nav>
      )}
    </article>

    {toc.length > 1 && (
      <aside class="toc" aria-label="목차">
        <p>목차</p>
        <ul>
          {toc.map((h) => (
            <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</BaseLayout>
