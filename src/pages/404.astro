---
// 없는 주소로 들어왔을 때 보여 주는 페이지.
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="페이지를 찾을 수 없음">
  <header class="page-head">
    <p class="eyebrow">404</p>
    <h1 class="page-title">없는 페이지다</h1>
    <p class="page-sub">주소가 바뀌었거나 지워진 글일 수 있다. <a href={base}>처음으로</a></p>
  </header>
</BaseLayout>
